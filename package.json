  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lenis": "^1.3.27",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource-variable/wix-madefor-text": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
