{
  "name": "autoprofi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "prebuild": "tsx scripts/restore-data.ts && tsx scripts/apply-overrides.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "import": "tsx scripts/import.ts",
    "images": "tsx scripts/images/run.ts",
    "images:generate": "tsx scripts/images/generate.ts",
    "images:sheet": "tsx scripts/images/sheet.ts",
    "export-data": "tsx scripts/export-data.ts",
    "restore-data": "tsx scripts/restore-data.ts",
    "check": "tsx scripts/check-build.ts",
    "build:design": "node scripts/build-design.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "admin:user": "tsx scripts/admin-user.ts",
    "apply-overrides": "tsx scripts/apply-overrides.ts",
    "publish": "node --env-file=.env.publish scripts/publish.mjs"
