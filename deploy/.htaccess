# Настройки Apache для виртуального хостинга reg.ru (Host-0).
#
# Кладётся в корень сайта рядом с index.html.
#
# ── Зачем он нужен ──
#
# Статическая выгрузка превращает каждую страницу в файл: /podbor
# становится podbor.html. Но все ссылки на сайте, карта сайта и
# микроразметка указывают на адреса без расширения, и менять их нельзя —
# они уже уйдут в поисковики, а переезд адресов стоит месяцев
# переиндексации.
#
# Поэтому адреса оставляем как есть, а серверу объясняем, какой файл
# им соответствует.

# ── Страницы без .html ──────────────────────────────────────────────

# Apache по умолчанию сам дописывает слеш, если видит папку с таким
# именем, и отвечает перенаправлением. У нас рядом с podbor.html лежит
# папка podbor с данными предзагрузки — из-за неё /podbor уводило на
# /podbor/, где индексной страницы нет, и сайт отдавал 403.
#
# Выключаем: пусть запрос доходит до правила ниже, которое отдаст
# podbor.html. Папки с содержимым от этого не страдают — к ним никто не
# обращается напрямую, их файлы запрашиваются по полному имени.
DirectorySlash Off

# Листинг папок наружу не отдаём: без индексной страницы это показало бы
# посетителю дерево служебных файлов.
Options -Indexes

RewriteEngine On

# Если запрошенного файла нет, но есть такой же с .html — отдаём его.
# Проверка на существование обязательна: без неё правило перехватило бы
# и картинки, и JSON-файлы каталога.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Обратная сторона: если человек пришёл по адресу с .html (например, из
# старой закладки), уводим его на канонический адрес без расширения.
# Иначе одна и та же страница доступна по двум адресам, и поисковик
# считает это дублем.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ── Один адрес вместо четырёх ───────────────────────────────────────
#
# Сайт должен открываться только по https://vashfarkop.ru. Остальные три
# варианта — с www, по http и по домену .online — перенаправляются сюда.
# Без этого поисковик видит четыре копии сайта и делит между ними вес.

# Два правила, а не одно с цепочкой условий. Так было сперва, и я
# ошибся: флаги писались двумя группами — [NC] [OR] вместо [NC,OR].
# Apache принял только первую, «или» в цепочке пропало, условия
# сложились через «и», и не срабатывало ни одно. Молча: ни ошибки, ни
# записи в журнале, просто сайт открывался по четырём адресам сразу.

# 1. Только https. Проверяем и переменную сервера, и заголовок от
#    балансировщика: на этом хостинге работают обе, но на других
#    площадках TLS снимает прокси, и до Apache доходит уже http.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://vashfarkop.ru%{REQUEST_URI} [R=301,L]

# 2. Только vashfarkop.ru. Отсюда уходят и www, и домен .online.
RewriteCond %{HTTP_HOST} !^vashfarkop\.ru$ [NC]
RewriteRule ^ https://vashfarkop.ru%{REQUEST_URI} [R=301,L]

# ── Страница 404 ────────────────────────────────────────────────────

ErrorDocument 404 /404.html

# ── Сжатие ──────────────────────────────────────────────────────────
#
# Картинки уже сжаты (webp), их трогать не надо — повторное сжатие
# только тратит процессор. А вот HTML каталога жмётся втрое: страница
# марки весит около 100 КБ текста.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Кэш у посетителя ────────────────────────────────────────────────
#
# Файлы сборки (/_next/static) содержат хеш в имени: меняется
# содержимое — меняется имя. Их можно кэшировать навсегда.
#
# HTML кэшировать нельзя: страницы меняются при каждой пересборке, а
# адрес у них один и тот же.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
